# Optional legacy server-side provider settings.
# The browser chat does NOT use these keys. Its remote keys are entered in Settings
# and sent directly from the browser to the provider selected by the user.
# Backend /api/chat and /api/chat/stream use only one configured provider.
# Set LUZYX_PROVIDER to: Groq, Gemini, NVIDIA Nemotron, or OpenRouter.
# If blank, the first configured key below is selected. There is NO failover.
LUZYX_PROVIDER=

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Performance controls
LUZYX_MAX_OUTPUT_TOKENS=500
LUZYX_MAX_HISTORY_TURNS=10
LUZYX_CONNECT_TIMEOUT=6
LUZYX_READ_TIMEOUT=35
